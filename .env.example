# Copy to .env (git-ignored) and fill in. Real environment variables override this file.

# Signs session tokens. REQUIRED in production: 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset in development, a random secret is used per run (everyone is signed out on restart).
JWT_SECRET=

# How long a sign-in lasts, in hours.
JWT_TTL_HOURS=8

# Roles that may use the dashboard. Users with other roles are refused at sign-in.
AUTH_ALLOWED_ROLES=cs,admin

# Defaults to config/users.json. Manage it with: npm run user -w backend -- add|remove|list
# AUTH_USERS_FILE=config/users.json

# Session cookie is Secure (HTTPS-only) when NODE_ENV=production; override here.
# COOKIE_SECURE=true

# Set when running behind a load balancer/reverse proxy (e.g. 1), so lockouts use real client IPs.
# TRUST_PROXY=1

# Logging: error | warn | info | debug | verbose; LOG_FORMAT=json for log shippers.
LOG_LEVEL=info
# LOG_FORMAT=json
